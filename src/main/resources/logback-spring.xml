<?xml version="1.0" encoding="UTF-8"?>

<configuration>

  <!-- 로그 출력 형식 -->
  <property
    name="LOG_PATTERN"
    value="%d{yy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

  <!-- 프로젝트 루트 기준 로그 저장 경로 -->
  <property name="LOG_DIR" value="./.logs"/>
  <property name="LOG_FILE" value="${LOG_DIR}/discodeit.log"/>

  <!-- 콘솔 출력 -->
  <appender name="CONSOLE"
    class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- 파일 출력 및 일자별 롤링 -->
  <appender name="FILE"
    class="ch.qos.logback.core.rolling.RollingFileAppender">

    <!-- 현재 기록 중인 파일 -->
    <file>${LOG_FILE}</file>

    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>

    <rollingPolicy
      class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

      <!-- 날짜가 변경되면 이전 로그를 날짜가 붙은 파일로 압축 -->
      <fileNamePattern>
        ${LOG_DIR}/discodeit.%d{yyyy-MM-dd}.log.gz
      </fileNamePattern>

      <!-- 최근 30일 보관 -->
      <maxHistory>30</maxHistory>

      <!-- 애플리케이션 시작 시 오래된 로그도 정리 -->
      <cleanHistoryOnStart>true</cleanHistoryOnStart>
    </rollingPolicy>
  </appender>

  <!-- 모든 환경에서 콘솔과 파일에 동시에 기록 -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>

</configuration>