# Docker Compose 실행 전 이 파일을 .env로 복사하세요.
# cp .env.example .env

# 애플리케이션
PROJECT_NAME=discodeit
PROJECT_VERSION=1.2-M8
JVM_OPTS=-Xms200m -Xmx400m
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=80
ADMIN_USER_NAME=change-me
ADMIN_USER_PASSWORD=change-me
ADMIN_USER_EMAIL=admin@discodeit.local
# JWT 서명용 비밀값을 무작위로 생성해 최소 32바이트 이상으로 설정하세요.
# 빈 값으로 두면 애플리케이션을 시작할 수 없습니다.
JWT_SECRET=
JWT_ACCESS_TOKEN_VALIDITY=10m
JWT_REFRESH_TOKEN_VALIDITY=14d
JWT_ISSUER=discodeit

REFRESH_COOKIE_HTTP_ONLY=true
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax

# 데이터베이스
POSTGRES_HOST_PORT=5434
DB_HOST=postgres
DB_PORT=5432
DB_NAME=discodeit
DB_USERNAME=discodeit_user
DB_PASSWORD=change-me

# 파일 저장소
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT_PATH=.discodeit/storage
AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET=your-s3-bucket-name
# 로컬 S3 호환 서버를 사용할 때만 지정하고, 실제 AWS S3 사용 시 비워 두세요.
AWS_S3_ENDPOINT=
AWS_S3_PRESIGNED_URL_EXPIRATION=600

# 공통 설정
TZ=Asia/Seoul
